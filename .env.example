DISCORD_TOKEN=
MONGODB_URI=
MONGODB_DB_NAME=underscore_verification
# Local db:init/db:check DNS resolvers; blank uses the system DNS.
# Cloudflare Workers uses its own DNS service; this setting is not uploaded.
MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
# Use MongoDB Atlas or another replica set; transactions are required.
DISCORD_CLIENT_ID=
# General Information > Public Key (not your bot token).
DISCORD_PUBLIC_KEY=
DISCORD_GUILD_ID=
# Access role and verification channels are stored in MongoDB.
# Configure them using /getrole and /channel setup in Discord.
YOUTUBE_CHANNEL_ID=
# YOUTUBE_CHANNEL_ID can also be set with /youtube setup.
# Required only to resolve YouTube usernames/@handles in /youtube setup.
# Create an API key restricted to YouTube Data API v3 in Google Cloud.
YOUTUBE_API_KEY=
TIKTOK_USERNAME=underscore
# youtube | tiktok | either | both
VERIFICATION_POLICY=either
# Set this after your first Worker deployment. No trailing path.
PUBLIC_URL=https://underscore-verification.YOUR-SUBDOMAIN.workers.dev

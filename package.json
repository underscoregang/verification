{
  "name": "underscore-verification",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "wrangler dev",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run --outdir dist",
    "cf:login": "wrangler login",
    "cf:whoami": "wrangler whoami",
    "db:init": "node scripts/database.js init",
    "db:check": "node scripts/database.js check",
    "db:import:d1": "node scripts/import-d1.js",
    "db:init:production": "node scripts/database.js init --env-file=.env.production",
    "db:check:production": "node scripts/database.js check --env-file=.env.production",
    "secrets:upload": "node scripts/upload-secrets.js",
    "secrets:upload:production": "node scripts/upload-secrets.js --env-file=.env.production",
    "secrets:upload:database:production": "node scripts/upload-secrets.js --env-file=.env.production --database-only",
    "setup:check": "node scripts/check-setup.js",
    "register": "node src/register.js",
    "endpoint:setup": "node scripts/configure-endpoint.js",
    "test": "node --test",
    "pretest": "npm run deploy:check",
    "check": "node --check src/index.js"
  },
  "dependencies": {
    "dotenv": "^17.2.2",
    "mongodb": "^7.7.0"
  },
  "devDependencies": {
    "miniflare": "^5.20261012.1-beta",
    "mongodb-memory-server": "^11.3.0",
    "wrangler": "^4.151.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  }
}
